{
  "name": "conductor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"pnpm --filter @conductor/server dev\" \"pnpm --filter @conductor/web dev\"",
    "start": "pnpm --filter @conductor/web build && pnpm --filter @conductor/server start",
    "demo:repo": "bash scripts/make-demo-repo.sh",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
